# Modelo para `docker compose build && docker compose up` À MÃO. No dockhand
# estas variáveis são preenchidas na interface.
#
# Copie para `.env` ao lado do docker-compose.yml.
#
# ⚠ TODAS as VITE_ são de BUILD, não de execução: o Vite as grava dentro do
# JavaScript na hora de construir. Trocar qualquer uma exige RECONSTRUIR a
# imagem (Git deploy no dockhand), não reiniciar o container.

# ── Onde publicar ────────────────────────────────────────────────────────────
# 127.0.0.1 = só a própria VM alcança (o portal da TI faz o proxy).
# 0.0.0.0    = qualquer um na rede da Cobeb alcança pelo IP:porta.
PUBLICAR_EM=127.0.0.1
# 8140. O Ciclo PHP (outro projeto) é o 8130.
PORTA_EXTERNA=8140

# ── Caminho ──────────────────────────────────────────────────────────────────
# `/` porque na VM o app fica na raiz do endereço. O padrão do vite.config.js é
# o caminho do GitHub Pages e faria a página abrir em branco.
VITE_BASE_URL=/

# ── Supabase (obrigatórias -- o build FALHA sem elas) ─────────────────────────
# A anon key é pública por natureza: ela vai dentro do JavaScript e é protegida
# pela segurança por linha (RLS) do Supabase. São as mesmas que já estão nos
# GitHub Secrets deste repositório.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=troque-pela-anon-key

# ⚠ NÃO acrescente VITE_SUPABASE_SERVICE_ROLE_KEY aqui.
# Ela ignora a segurança por linha e iria dentro do JavaScript que o navegador
# baixa -- qualquer pessoa poderia ler e escrever o banco inteiro.

# ── Opcionais ────────────────────────────────────────────────────────────────
# Sem ORS o mapa não traça rota; sem APK_URL a tela de instalar fica sem link.
VITE_ORS_API_KEY=
VITE_APK_URL=
